<Window x:Class="TransportationSystem.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Payment" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="Manage Payment" Style="{StaticResource ModernTextBlock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Method" Style="{StaticResource ModernTextBlock}"/>
                <ComboBox x:Name="PaymentMethodComboBox" Style="{StaticResource ModernComboBox}" Width="300">
                    <ComboBoxItem Content="Credit Card"/>
                    <ComboBoxItem Content="Debit Card"/>
                    <ComboBoxItem Content="PayPal"/>
                </ComboBox>
                <TextBlock Text="Card Number" Style="{StaticResource ModernTextBlock}" Margin="0,10,0,0"/>
                <TextBox x:Name="CardNumberTextBox" Style="{StaticResource ModernTextBox}" Width="300"/>
                <TextBlock Text="Expiry Date" Style="{StaticResource ModernTextBlock}" Margin="0,10,0,0"/>
                <DatePicker x:Name="CardExpiryDatePicker" Style="{StaticResource ModernDatePicker}" Width="300"/>
                <TextBlock Text="Bank" Style="{StaticResource ModernTextBlock}" Margin="0,10,0,0"/>
                <TextBox x:Name="BankTextBox" Style="{StaticResource ModernTextBox}" Width="300"/>
                <Button Content="Save Payment" Style="{StaticResource ModernButton}" Click="SavePaymentButton_Click" Width="200" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>