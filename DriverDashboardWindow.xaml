<Window x:Class="TransportationSystem.DriverDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Dashboard" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="WelcomeTextBlock" Text="Welcome, Driver!" Style="{StaticResource ModernTextBlock}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatsTextBlock" Text="Rides: 0 | Rating: 0" Style="{StaticResource ModernTextBlock}" FontSize="18" Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center" Margin="0,10,0,20"/>
            <Button Content="View Assigned Trips" Style="{StaticResource ModernButton}" Click="ViewAssignedTripsButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <Button Content="Manage Vehicle" Style="{StaticResource ModernButton}" Click="ManageVehicleButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>