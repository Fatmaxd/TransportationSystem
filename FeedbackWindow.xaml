<Window x:Class="TransportationSystem.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leave Feedback" Height="400" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="Leave Feedback" Style="{StaticResource ModernTextBlock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Comment" Style="{StaticResource ModernTextBlock}"/>
                <TextBox x:Name="CommentTextBox" Style="{StaticResource ModernTextBox}" Width="300" Height="100" AcceptsReturn="True"/>
                <TextBlock Text="Rating (1-5)" Style="{StaticResource ModernTextBlock}" Margin="0,10,0,0"/>
                <ComboBox x:Name="RatingComboBox" Style="{StaticResource ModernComboBox}" Width="300">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
                <Button Content="Submit Feedback" Style="{StaticResource ModernButton}" Click="SubmitFeedbackButton_Click" Width="200" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>