<Window x:Class="TransportationSystem.UserDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Dashboard" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
	<Grid Margin="20">
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
			<TextBlock x:Name="WelcomeTextBlock" Text="Welcome to Your Dashboard!" Style="{StaticResource ModernTextBlock}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
			<Button Content="Book a Trip" Style="{StaticResource ModernButton}" Click="BookTripButton_Click" Width="250" Margin="0,20,0,0" HorizontalAlignment="Center"/>
			<Button Content="Manage Payment" Style="{StaticResource ModernButton}" Click="ManagePaymentButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
			<Button Content="Apply Promo Code" Style="{StaticResource ModernButton}" Click="ApplyPromoButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
			<Button Content="View Trip History" Style="{StaticResource ModernButton}" Click="ViewTripHistoryButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
			<Button Content="Leave Feedback" Style="{StaticResource ModernButton}" Click="LeaveFeedbackButton_Click" Width="250" Margin="0,10,0,0" HorizontalAlignment="Center"/>
		</StackPanel>
	</Grid>
</Window>