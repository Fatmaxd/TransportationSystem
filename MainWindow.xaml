<Window x:Class="TransportationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transportation System" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Transportation App" Style="{StaticResource ModernTextBlock}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Your journey starts here!" Style="{StaticResource ModernTextBlock}" FontSize="18" Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center" Margin="0,10,0,20"/>
                <Button Content="Login" Style="{StaticResource ModernButton}" Click="LoginButton_Click" Width="200" HorizontalAlignment="Center"/>
                <Button Content="Sign Up" Style="{StaticResource ModernButton}" Click="SignUpButton_Click" Width="200" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>