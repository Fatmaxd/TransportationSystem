<Window x:Class="TransportationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transportation System" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="#FF1A1A1A">
    <Grid>
        <Border Background="#FF2D2D2D" Width="200" HorizontalAlignment="Left">
            <StackPanel Margin="10">
                <TextBlock Text="Transportation System" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10"/>
                <Button Content="Login" Style="{StaticResource ModernButton}" Click="LoginButton_Click"/>
                <Button Content="Sign Up" Style="{StaticResource ModernButton}"/>
                <Button Content="User Dashboard" Style="{StaticResource ModernButton}"/>
                <Button Content="Driver Dashboard" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Border>
        <Border Margin="200,0,0,0" Background="#FFF5F5F5" CornerRadius="10">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>