<Window x:Class="TransportationSystem.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Role" Height="400" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ActionTextBlock" Text="Select Your Role" Style="{StaticResource ModernTextBlock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <Button x:Name="UserButton" Content="User" Style="{StaticResource ModernButton}" Click="UserButton_Click" Width="200" HorizontalAlignment="Center"/>
                <Button x:Name="DriverButton" Content="Driver" Style="{StaticResource ModernButton}" Click="DriverButton_Click" Width="200" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>