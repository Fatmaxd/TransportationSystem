<Window x:Class="TransportationSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" Background="#FFF5F5F5">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Login" FontSize="24" FontWeight="Bold" Foreground="#FF1A1A1A" HorizontalAlignment="Center"/>
            <TextBlock Text="Email" FontSize="14" Margin="0,20,0,5"/>
            <TextBox x:Name="EmailTextBox" Width="300" Padding="5" FontSize="14"/>
            <TextBlock Text="Password" FontSize="14" Margin="0,10,0,5"/>
            <PasswordBox x:Name="PasswordBox" Width="300" Padding="5" FontSize="14"/>
            <Button Content="Login" Style="{StaticResource ModernButton}" Width="100" Margin="0,20" Click="LoginSubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>