<Window x:Class="TransportationSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="400" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Login" Style="{StaticResource ModernTextBlock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Email" Style="{StaticResource ModernTextBlock}"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource ModernTextBox}" Width="300"/>
                <TextBlock Text="Password" Style="{StaticResource ModernTextBlock}" Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Width="300"/>
                <Button Content="Login" Style="{StaticResource ModernButton}" Click="LoginSubmitButton_Click" Width="200" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>