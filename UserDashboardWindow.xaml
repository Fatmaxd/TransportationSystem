<Window x:Class="TransportationSystem.UserDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Dashboard" Height="600" Width="600"
        WindowStartupLocation="CenterScreen" Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="WelcomeTextBlock" Text="Welcome to Your Dashboard!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock Text="Book a New Trip" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Pick-Up Location" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="PickUpTextBox" Width="300" Padding="5" FontSize="14" HorizontalAlignment="Left"/>
            <TextBlock Text="Destination" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="DestinationTextBox" Width="300" Padding="5" FontSize="14" HorizontalAlignment="Left"/>
            <TextBlock Text="Pick-Up Date &amp; Time" FontSize="14" Margin="0,10,0,5"/>
            <DatePicker x:Name="PickDatePicker" Width="300" HorizontalAlignment="Left" SelectedDateFormat="Short"/>
            <TextBox x:Name="PickTimeTextBox" Width="300" Padding="5" FontSize="14" HorizontalAlignment="Left" Margin="0,5,0,0" Text="08:00" ToolTip="Enter time (HH:mm)"/>
            <Button Content="Book Trip" Width="100" Margin="0,20,0,0" HorizontalAlignment="Left" Click="BookTripButton_Click"/>
        </StackPanel>
        <ListView x:Name="TripListView" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Pick-Up Location" Width="150" DisplayMemberBinding="{Binding PickUp}"/>
                    <GridViewColumn Header="Destination" Width="150" DisplayMemberBinding="{Binding Destination}"/>
                    <GridViewColumn Header="Pick-Up Date" Width="150" DisplayMemberBinding="{Binding PickDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                    <GridViewColumn Header="Duration" Width="100" DisplayMemberBinding="{Binding Duration}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>